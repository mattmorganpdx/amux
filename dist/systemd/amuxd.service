[Unit]
Description=amux terminal daemon
Documentation=https://github.com/mattmorganpdx/amux
Requires=amuxd.socket
After=amuxd.socket

[Service]
Type=simple
ExecStart=@AMUXD@

# Agrees with ListenStream in amuxd.socket. The daemon passes this to every
# pane as AMUX_SOCKET_PATH, so amux-cli run inside a pane reaches the daemon
# that owns it.
Environment=AMUX_SOCKET=%t/amux.sock

# Panes inherit the daemon's limits, so this is what every terminal in amux
# gets. systemd's default soft limit is 1024 -- kept low for programs that still
# use select() -- while a login shell here gets 1048576. Anything ordinary run in
# a pane then hit a ceiling that does not exist in a normal terminal: this
# project's own test suite, which spawns a pty per test, went from 9 seconds to
# over five minutes and then failed. A terminal should behave like a terminal.
LimitNOFILE=1048576

# The daemon owns live terminals and drains in-flight socket handlers on the
# way out; give it room to do that rather than being killed mid-request.
TimeoutStopSec=20

Restart=on-failure
RestartSec=1

[Install]
WantedBy=default.target
